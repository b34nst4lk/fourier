//// Ground truth for the score port: the STAR fixture, generated OUTSIDE the
//// browser package.
////
//// Where these numbers come from: `sketch.star()`'s 10 dots -> fourier_sketch's
//// arc-length `resample_closed(dots, 512)` (the pipeline toy_admin's
//// derivation runs at save time) -> forward DFT -> top-4 dial truth, centroid,
//// and the metric's normalizer. That is, this is the real star the editor will
//// test-play, not a hand-tuned shape. admin_ui has no dependency on
//// fourier_sketch (it must stay a browser-only package), so the 512-point trace
//// is embedded here once, as text, and parsed at test time.
////
//// The trace is rounded to 6 decimals. The recorded reference numbers were
//// computed from the unrounded values; rounding moves the match percentage by
//// well under 0.001, which the assertions' tolerances absorb.
////
//// Pinned facts (see score_test):
////   centroid    (50.0, 49.999824523925774)
////   rms_polar    28.51395900062217
////   truth match  97.68891741835091   (the four dial terms alone, no extras)
////   start match  -45.206467602909626 (raw; the metric clamps it to 0)

import admin_ui/score.{type Point, type Term, Term}
import gleam/float
import gleam/list
import gleam/result
import gleam/string

/// The k = 0 term's position (the star is centred near, not at, 50/50).
pub const centroid = #(50.0, 49.999824523925774)

/// The target trace's RMS polar radius — the metric's normalizer.
pub const rms_polar = 28.51395900062217

/// The four dialable terms, in the fixture's (amplitude) order: k=+1, k=-4,
/// k=+6, k=-14 — the derivation's arrangement, not the toy's p6 patch.
pub fn dial() -> List(Term) {
  [
    Term(1, 27.574653306648354, 270.00000000000034),
    Term(-4, 6.587099924414947, 270.0000000000019),
    Term(6, 2.9276293593855414, 270.00000000000006),
    Term(-14, 0.5377710335446912, 270.0000000000257),
  ]
}

/// The 512-point target trace, parsed from the embedded CSV.
pub fn target() -> List(Point) {
  string.split(target_csv(), ";")
  |> list.map(fn(pair) {
    case string.split(pair, ",") {
      [x, y] -> #(parse(x), parse(y))
      _ -> #(0.0, 0.0)
    }
  })
}

fn parse(text: String) -> Float {
  float.parse(string.trim(text))
  |> result.unwrap(0.0)
}

